@page "/admin/create-forum"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Snackis1.Data.Entities
@using Snackis1.Services

@inject ForumService ForumService
@inject NavigationManager Navigation


<h3>Skapa nytt forum</h3>

<EditForm Model="@newForum" OnValidSubmit="CreateNewForum" FormName="CreateForumFrom">
	<DataAnnotationsValidator/>
	<ValidationSummary/>

	<div class="mb-3">
		<label class="form-label">Forumrubrik</label>
		<InputText class="form-control" @bind-Value="newForum.Title"/>
	</div>

	<button type="submit" class="btn btn-brand">Skapa Forum</button>


</EditForm>



@code {

	private ForumInputModel newForum = new();
	

	private async Task CreateNewForum()
	{
		var forum = new Forum
			{
				Title = newForum.Title
			};


			await ForumService.AddForumAsync(forum);

			Navigation.NavigateTo("/admin?forumCreated=true");
	}


	public class ForumInputModel
	{
		[Required(ErrorMessage = "Du måste ange en forumrubrik.")]
		[StringLength(100, ErrorMessage = "Forumrubriken får vara högst 100 tecken.")]
		public string Title { get; set; } = "";
	}

}
