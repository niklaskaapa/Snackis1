@page "/post/{PostId:int}"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using Snackis1.Data.Entities
@using Snackis1.Data.Enum
@using Snackis1.Services
@using Snackis1.Services.ApiModels


@inject ForumService ForumService
@inject CurrentUserService CurrentUser
@inject PostApiService PostApiService

@inject ReportService ReportService
@inject NavigationManager Navigation



@if (isLoading)
{
    <p>Laddar inlägg...</p>
}
else if (post == null)
{
    <p>Inlägget kunde inte hittas.</p>
}
else
{
    <p class="text-muted text-center">
        <a href="/forum">Forum</a> &gt;
        @post.ForumTitle &gt;
        <a href="@($"/category/{post.CategoryId}")">@post.CategoryName</a> &gt;
        @post.Title
    </p>


    <h3>@post.Title</h3>

    <div class="card mb-4">
        <div class="card-body">

            <div class="d-flex">

                <div class="me-4 text-center" style="width: 120px;">

                    @if (!string.IsNullOrEmpty(post.ProfileImageUrl))
                    {
                        <img src="@post.ProfileImageUrl"
                             alt="Profilbild"
                             class="rounded-circle"
                             style="width: 100px; height: 100px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                             style="width: 100px; height: 100px; font-size: 2.5rem;">
                            @GetInitial(post.Author)
                        </div>
                    }

                    <div class="mt-2">
                        <strong>@post.Author</strong>
                    </div>

                </div>

                <div class="flex-grow-1">

                    <p>@post.Content</p>

                    <hr />

                    <small class="text-muted">
                        @post.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                    </small>

                    <AuthorizeView>
                        <Authorized>
                            @if (currentUserId != post.UserId)
                            {
                            <button class="btn btn-brand btn-sm" @onclick="() => SendDm(post.UserId)">
                                Skicka DM
                            </button>
                            }
                        </Authorized>
                    </AuthorizeView>

                </div>

            </div>

        </div>
    </div>

    <h4>Kommentarer</h4>

    @if (!post.Comments.Any())
    {
        <p>Det finns inga kommentarer ännu.</p>
    }
    else
    {
        @foreach (var comment in post.Comments)
        {
            <div class="card mb-3">
                <div class="card-body">

                    <div class="d-flex">

                        <div class="me-3 text-center" style="width: 80px;">

                            @if (!string.IsNullOrEmpty(comment.ProfileImageUrl))
                            {
                                <img src="@comment.ProfileImageUrl"
                                     alt="Profilbild"
                                     class="rounded-circle"
                                     style="width: 60px; height: 60px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                                     style="width: 60px; height: 60px; font-size: 1.5rem;">
                                    @GetInitial(comment.Author)
                                </div>
                            }

                            <div class="mt-1">
                                <small>
                                    <strong>@comment.Author</strong>
                                </small>
                            </div>

                        </div>

                        <div class="flex-grow-1">

                            <p>@comment.Content</p>

                            <small class="text-muted">
                                @comment.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            </small>

                            <AuthorizeView>
                                <Authorized>
                                    @if (currentUserId != comment.UserId)
                                    {
                                    <button class="btn btn-brand btn-sm" @onclick="() => SendDm(comment.UserId)">
                                        Skicka DM
                                    </button>
                                    }
                                </Authorized>
                            </AuthorizeView>

                        </div>

                    </div>

                </div>
            </div>
        }
    }

    <AuthorizeView>
        <Authorized Context="authContext">

            <h4>Skriv en kommentar</h4>

            <EditForm Model="@newComment"
                      OnValidSubmit="CreateComment"
                      FormName="CreateCommentForm">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <InputTextArea class="form-control"
                                   rows="5"
                                   @bind-Value="newComment.Content"
                                   placeholder="Skriv din kommentar..." />
                </div>

                <button type="submit" class="btn btn-brand mb-3">
                    Skicka kommentar
                </button>

            </EditForm>


            <button class="btn btn-warning mb-3" 
                @onclick="() => showReportForm = true">
                Anmäl inlägg
            </button>

            @if (showReportSent)
            {
                <div class="alert alert-success mt-3">
                    Din anmälan har skickats till admin.
                </div>
            }


            
            @if (showReportForm)
            {
                <div class="mt-3">
                    <EditForm Model="@newReport"
                              OnValidSubmit="ReportPost"
                              FormName="ReportPostForm">

                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">
                                Orsak till anmälan?
                            </label>

                            <InputTextArea class="form-control"
                                           @bind-Value="newReport.Reason"
                                           maxlength="250"
                                           placeholder="Beskriv kort varför du anmäler inlägget..." />
                        </div>

                        <button type="submit" class="btn btn-warning me-2">
                            Skicka anmälan
                        </button>

                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="() => showReportForm = false">
                            Avbryt
                        </button>

                    </EditForm>
                </div>
            }
            

        </Authorized>


        <NotAuthorized>

            <p>Du måste vara inloggad för att kommentera.</p>

        </NotAuthorized>
    </AuthorizeView>
}

@code {

    [Parameter]
    public int PostId { get; set; }

    private bool isLoading = true;
    private PostApiDto? post;
    private bool showReportForm;
    private string? currentUserId;
    private bool showReportSent;

    private CommentInputModel newComment = new();
    private ReportInputModel newReport = new();


    protected override async Task OnInitializedAsync()
    {

        currentUserId = await CurrentUser.GetUserIdAsync();


        post = await PostApiService.GetPostByIdAsync(PostId);

        isLoading = false;

    }

    private async Task CreateComment()
    {
        var userId = await CurrentUser.GetUserIdAsync();

        if (userId == null)
        {
            return;
        }

        var comment = new Comment
        {
            Content = newComment.Content,
            CreatedAt = DateTime.Now,
            UserId = userId,
            PostId = PostId
        };

        await ForumService.AddCommentAsync(comment);

        newComment = new CommentInputModel();

        post = await PostApiService.GetPostByIdAsync(PostId);
    }

    private static string GetInitial(string? userName)
    {
        if (string.IsNullOrWhiteSpace(userName))
        {
            return "?";
        }

        return userName.Trim()[0].ToString().ToUpper();
    }


    private async Task ReportPost()
    {

        var userId = await CurrentUser.GetUserIdAsync();

        if (string.IsNullOrEmpty(userId))
        {
            return;
        }

        var report = new Report
            {
                PostId = PostId,
                ReporterId = userId,
                Reason = newReport.Reason,
                CreatedAt = DateTime.Now,
                Status = ReportStatus.Pending,


            ReportedPostTitle = post?.Title ?? "TITEL SAKNAS",
            ReportedPostAuthor = post?.Author ?? "FÖRFATTARE SAKNAS"

            };

        await ReportService.AddReportAsync(report);

        newReport = new ReportInputModel();
        showReportForm = false;

        showReportSent = true;
        _ = HideReportSentAsync();

    }

    private async Task HideReportSentAsync()
    {
        await Task.Delay(3000);

        showReportSent = false;

        await InvokeAsync(StateHasChanged);
    }



    private void SendDm(string userId)
    {
        if (!string.IsNullOrWhiteSpace(userId))
        {
            Navigation.NavigateTo(
             $"/messages/send?receiverId={Uri.EscapeDataString(userId)}");
        }
    }


	public class CommentInputModel
	{
		[Required(ErrorMessage = "Du måste skriva en kommentar.")]
		public string Content { get; set; } = "";
	}


	public class ReportInputModel
	{
		[Required(ErrorMessage = "Du måste ange en anledning.")]
		[StringLength(200, ErrorMessage = "Anledningen får vara högst 200 tecken.")]
		public string Reason { get; set; } = "";
	}


}